      "source": [
        "import torch\n",
        "import torch.nn as nn\n",
        "import numpy as np\n",
        "import gradio as gr\n",
        "import os"
      ],
      "metadata": {
        "id": "bHSx8zcBXISa"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "# 1. MODEL TANIMI (Eski model.py)"
      ],
      "metadata": {
        "id": "7KMA0F6HXCuF"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "class LSTMModelDemo(nn.Module):\n",
        "    def __init__(self):\n",
        "        super(LSTMModelDemo, self).__init__()\n",
        "        self.lstm = nn.LSTM(input_size=1, hidden_size=50, batch_first=True)\n",
        "        self.fc = nn.Linear(50, 1)\n",
        "\n",
        "    def forward(self, x):\n",
        "        # x: [batch, seq_len, input_size]\n",
        "        out, _ = self.lstm(x)\n",
        "        out = out[:, -1, :]  # Son zaman adımındaki çıktıyı al\n",
        "        out = self.fc(out)\n",
        "        return out"
      ],
      "metadata": {
        "id": "mB4UYhX-XDXL"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "# 2. EĞİTİM VE VERİ HAZIRLIĞI (Eski train.py)\n"
      ],
      "metadata": {
        "id": "OO2uQMPQXNKI"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "# Veri seti oluşturma (0..999 arası sayılar)\n",
        "data = np.arange(1000)\n",
        "X_list = []\n",
        "y_list = []\n",
        "seq_length = 4  # 4 sayı verip 5. sayıyı tahmin etme\n",
        "\n",
        "for i in range(len(data) - seq_length):\n",
        "    X_list.append(data[i:i + seq_length])\n",
        "    y_list.append(data[i + seq_length])\n",
        "\n",
        "X_train = torch.tensor(np.array(X_list), dtype=torch.float32).unsqueeze(-1)\n",
        "y_train = torch.tensor(np.array(y_list), dtype=torch.float32).unsqueeze(-1)\n",
        "\n",
        "# Model, Kayıp Fonksiyonu ve Optimizer\n",
        "model = LSTMModelDemo()\n",
        "criterion = nn.MSELoss()\n",
        "optimizer = torch.optim.Adam(model.parameters(), lr=0.01)\n",
        "\n",
        "# Eğitim Döngüsü\n",
        "epochs = 500  # Hızlı sonuç için epoch sayısı düşürüldü, ihtiyaca göre artırabilirsin\n",
        "print(\"Eğitim başlıyor...\")\n",
        "\n",
        "for epoch in range(epochs):\n",
        "    optimizer.zero_grad()\n",
        "    output = model(X_train)\n",
        "    loss = criterion(output, y_train)\n",
        "    loss.backward()\n",
        "    optimizer.step()\n",
        "\n",
        "    if (epoch + 1) % 50 == 0:\n",
        "        print(f\"Epoch {epoch+1}, Loss: {loss.item():.4f}\")\n",
        "\n",
        "# Modeli Kaydet\n",
        "model_path = \"lstm_model.pth\"\n",
        "torch.save(model.state_dict(), model_path)\n",
        "print(f\"\\nModel '{model_path}' olarak kaydedildi.\")\n",
        "\n",
        "# ==========================================\n",
        "# 3. ARAYÜZ VE SERVİS (Eski serve.py)\n",
        "# ==========================================\n",
        "\n",
        "def process_input(inputs_number):\n",
        "    try:\n",
        "        # Girdiyi temizle ve listeye çevir\n",
        "        num_list = [float(x.strip()) for x in inputs_number.strip().split(',')]\n",
        "\n",
        "        if len(num_list) != 4:\n",
        "            return f\"Hata: 4 adet sayı girmelisiniz. Mevcut adet: {len(num_list)}\"\n",
        "\n",
        "        # Tahmin işlemi\n",
        "        test_seq = torch.tensor([num_list], dtype=torch.float32).unsqueeze(-1)\n",
        "        model.eval() # Modeli değerlendirme moduna al\n",
        "        with torch.no_grad():\n",
        "            pred = model(test_seq)\n",
        "\n",
        "        return f\"Tahmin Edilen Sonraki Sayı: {round(pred.item())}\"\n",
        "\n",
        "    except ValueError:\n",
        "        return \"Hata: Lütfen sadece virgülle ayrılmış sayılar girin (Örn: 10,11,12,13)\"\n",
        "    except Exception as e:\n",
        "        return f\"Sistemsel Hata: {str(e)}\"\n",
        "\n",
        "# Gradio Arayüzü\n",
        "interface = gr.Interface(\n",
        "    fn=process_input,\n",
        "    inputs=gr.Textbox(lines=2, placeholder=\"Örn: 50,51,52,53\"),\n",
        "    outputs=gr.Textbox(label=\"Sonuç\"),\n",
        "    title=\"LSTM Sayı Tahmin Modeli\",\n",
        "    description=\"Ardışık 4 sayıyı virgülle ayırarak girin, model bir sonraki sayıyı tahmin etsin.\",\n",
        "    examples=[[\"50,51,52,53\"], [\"100,101,102,103\"]]\n",
        ")\n",
        "\n",
        "# Notebook içerisinde arayüzü başlat\n",
        "interface.launch(share=True, debug=True)"
      ],
